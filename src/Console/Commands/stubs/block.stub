<?php

namespace {{ namespace }};

use Thyme\Framework\Blocks\Block;
use Thyme\Framework\Icons\DashIcons;
use Extended\ACF\Fields\Text;

class {{ class }} extends Block
{
    protected ?string $title = 'DummyTitle';

    protected string $name = 'DummyName';

    protected ?string $description = 'DummyDescription';

    protected ?string $category = 'DummyCategory';

    protected DashIcons $icon = DashIcons::DummyIcon;

    public function fields(): array {
    	return [
    		Text::make( 'Titel', 'title' )->required()->default('title'),
    	];
    }

    public function scripts(): array
    {
        return ['@vite:/DummyAssetPath.ts'];
    }

    public function styles(): array
    {
        return ['@vite:/DummyAssetPath.css'];
    }
}
